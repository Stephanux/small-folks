    "GET/view/user/:id": {
        "plugin":      "./target/release/libplugin_sql.so",
        "sql":         "SELECT CAST(id_users AS CHAR), name, firstName, login, function, office, code_countries FROM users WHERE id_users = :id",
        "view":        "generics/formGeneric.hbs",
        "form_action": "/update_user",
        "form_columns": 2,
        "form_fullwidth_fields": ["addresse1", "addresse2", "city"],
        "return_type": "html",
        "auth":        true,
        "data_resources": {
            "code_countries": "countries",
            "function":       "functions"
        },
        "sql_resources": {
            "countries": "SELECT code, name_fr FROM countries ORDER BY name_fr",
            "functions": "SELECT DISTINCT function, function FROM users ORDER BY function"
        }
    },
    "GET/users": {
        "plugin": "./target/release/libplugin_sql.so",
        "sql": "SELECT name, firstName, login, mdp, function, office, date_naiss, addresse1, addresse2, cp, city, code_countries, mobile_phone, home_phone FROM users",
        "view": "generics/tableGeneric.hbs",
        "return_type": "html"
    },
    "GET/view/user": {
        "plugin": "./target/release/libplugin_sql.so",
        "sql": "SELECT name, firstName, login, mdp, function, office, date_naiss, addresse1, addresse2, cp, city, code_countries, mobile_phone, home_phone FROM users LIMIT 1",
        "view": "generics/formGeneric.hbs",
        "return_type": "html",
        "form_action": "/insert_user",
        "form_columns": 2,
        "form_fullwidth_fields": ["addresse1", "addresse2", "city"],
        "auth":        true,
        "data_resources": {
            "code_countries": "countries",
            "function":       "functions"
        },
        "sql_resources": {
            "countries": "SELECT code, name_fr FROM countries ORDER BY name_fr",
            "functions": "SELECT DISTINCT function, function FROM users ORDER BY function"
        }
    },
    "POST/insert_user": {
        "plugin": "./target/release/libplugin_sql.so",
        "sql": "INSERT INTO users (name, firstName, login, mdp, function, office, date_naiss, addresse1, addresse2, cp, city, code_countries, mobile_phone, home_phone) VALUES (:name, :firstName, :login, :mdp, :function, :office, :date_naiss, :addresse1, :addresse2, :cp, :city,:code_countries, :mobile_phone, :home_phone)",
        "view": "",
        "return_type": "redirect",
        "redirect_to": "/users"
    },
    "POST/update_user": {
        "plugin": "./target/release/libplugin_sql.so",
        "sql": "UPDATE countries SET name = :name_us, firstName = :firstName, login = :login, mdp = :mdp, function = :function, office = :office,  date_naiss = :date_naiss, addresse1 = :addresse1, addresse2 = :addresse2, cp = :cp, city = :city,  code_countries = :code_countries, mobile_phone = :mobile_phone, home_phone = :home_phone WHERE id_users = :id_users",
        "view": "",
        "return_type": "redirect",
        "redirect_to": "/users"
    },
