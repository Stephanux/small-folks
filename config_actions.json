{
    "GET/error": {
        "plugin": "",
        "sql": "",
        "view": "error.hbs",
        "return_type": "html"
    },
    "GET/communes": {
        "plugin": "./target/release/libplugin_sql.so",
        "sql": "SELECT Code_commune_INSEE, Nom_de_la_commune, Code_postal FROM communes ORDER BY Code_commune_INSEE",
        "view": "generics/tableGeneric.hbs",
        "return_type": "html"
    },
    "GET/countries": {
        "plugin": "./target/release/libplugin_sql.so",
        "sql": "SELECT code, name_us, name_fr, region FROM countries ORDER BY name_us",
        "view": "generics/tableGeneric.hbs",
        "return_type": "html"
    },
    "GET/view/countries": {
        "plugin": "./target/release/libplugin_sql.so",
        "sql": "SELECT code, name_us, name_fr, region FROM countries LIMIT 1",
        "view": "specifics/form_countries.hbs",
        "return_type": "html"
    },
    "GET/api/countries": {
        "plugin": "./target/release/libplugin_sql.so",
        "sql": "SELECT code, name_us, name_fr FROM countries ORDER BY name_us",
        "view": "",
        "return_type": "json"
    },
    "GET/countries/:code": {
        "plugin": "./target/release/libplugin_sql.so",
        "sql": "SELECT code, name_us, name_fr FROM countries WHERE code=:code",
        "view": "generics/tableGeneric.hbs",
        "return_type": "html"
    },
    "GET/api/countries/:code": {
        "plugin": "./target/release/libplugin_sql.so",
        "sql": "SELECT code, name_us, name_fr FROM countries WHERE code=:code",
        "view": "",
        "return_type": "json"
    },
    "POST/countries": {
        "plugin": "./target/release/libplugin_sql.so",
        "sql": "INSERT INTO countries (code, name_us, name_fr) VALUES (:code, :name_us, :name_fr) ON DUPLICATE KEY UPDATE name_us = :name_us, name_fr = :name_fr",
        "view": "",
        "return_type": "redirect",
        "redirect_to": "/countries"
    },
	"POST/delete_country": {
        "plugin": "./target/release/libplugin_sql.so",
		"sql": "delete from countries where code=:code",
		"view": "generics/tableGeneric.hbs"
	},
    "PUT/countries/:code": {
        "plugin": "./target/release/libplugin_sql.so",
        "sql": "UPDATE countries SET name_us = :name_us, name_fr = :name_fr WHERE code = :code",
        "view": "",
        "return_type": "redirect",
        "redirect_to": "/countries"
    },
    "DELETE/countries/:code": {
        "plugin": "./target/release/libplugin_sql.so",
        "sql": "DELETE FROM countries WHERE code = :code",
        "view": "",
        "return_type": "json"
    },
    "GET/regions": {
        "plugin": "./target/release/libplugin_sql.so",
        "sql": "SELECT COALESCE(region, 'Unknown') AS region, CAST(COUNT(*) As CHAR) AS country_count FROM countries GROUP BY region ORDER BY country_count DESC",
        "view": "generics/tableGeneric.hbs",
        "return_type": "html"
    },
    "GET/api/regions": {
        "plugin": "./target/release/libplugin_sql.so",
        "sql": "SELECT COALESCE(region, 'Unknown') AS region, CAST(COUNT(*) As CHAR) AS country_count FROM countries GROUP BY region ORDER BY country_count DESC",
        "view": "",
        "return_type": "json"
    },
    "GET/regions/:name": {
        "plugin": "./target/release/libplugin_sql.so",
        "sql": "SELECT code, name_us, name_fr FROM countries WHERE region = :name ORDER BY name_us",
        "view": "generics/tableGeneric.hbs",
        "return_type": "html"
    },
    "GET/mongo/countries": {
        "plugin": "./target/release/libplugin_mongo.so",
        "collection": "countries",
        "filter": "{}",
        "operation": "find",
        "return_type": "html",
        "view": "generics/tableGeneric.hbs"
    },
    "GET/api/mongo/countries": {
        "plugin": "./target/release/libplugin_mongo.so",
        "collection": "countries",
        "filter": "{}",
        "operation": "find",
        "return_type": "json"
    },
    "GET/api/mongo/countries/:id": {
        "plugin": "./target/release/libplugin_mongo.so",
        "collection": "countries",
        "filter": "{\"_id\": \":id\"}",
        "operation": "find_one",
        "return_type": "json"
    },
    "POST/api/mongo/countries": {
        "plugin": "./target/release/libplugin_mongo.so",
        "collection": "countries",
        "operation": "insert_one",
        "return_type": "json"
    },
    "PUT/api/mongo/countries/:id": {
        "plugin": "./target/release/libplugin_mongo.so",
        "collection": "countries",
        "filter": "{\"_id\": \":id\"}",
        "operation": "update_one",
        "return_type": "json"
    },
    "DELETE/api/mongo/countries/:id": {
        "plugin": "./target/release/libplugin_mongo.so",
        "collection": "countries",
        "filter": "{\"_id\": \":id\"}",
        "operation": "delete_one",
        "return_type": "json"
    },
    "GET/upload/form": {
        "plugin":      "",
        "sql":         "",
        "view":        "generics/upload_form.hbs",
        "return_type": "html"
    },
    "POST/upload": {
        "plugin":       "./target/release/libplugin_upload.so",
        "allowed_mime": "image/jpeg,image/png,application/pdf",
        "max_size_mb":  "10",
        "return_type":  "redirect",
        "redirect_to":  "/uploads"
    },
    "GET/uploads": {
        "plugin":      "./target/release/libplugin_sql.so",
        "sql":         "SELECT id, filename, stored_as, mime_type, CAST(size_bytes AS CHAR) AS size_bytes, upload_dir, CAST(created_at AS CHAR) AS created_at FROM uploads ORDER BY created_at DESC",
        "view":        "generics/upload_list.hbs",
        "return_type": "html"
    },
    "GET/api/uploads": {
        "plugin":      "./target/release/libplugin_sql.so",
        "sql":         "SELECT id, uuid, filename, stored_as, mime_type, CAST(size_bytes AS CHAR) AS size_bytes, upload_dir, CAST(created_at AS CHAR) AS created_at FROM uploads ORDER BY created_at DESC",
        "return_type": "json"
    },
    "DELETE/uploads/:uuid": {
        "plugin":      "./target/release/libplugin_sql.so",
        "sql":         "DELETE FROM uploads WHERE uuid = :uuid",
        "return_type": "json"
    }
}
