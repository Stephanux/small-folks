# Copiez ce fichier en .env et adaptez les valeurs
DATABASE_URL=mysql://admin:password@localhost:3306/database?charset=utf8mb4
HOST=127.0.0.1
PORT=8080
CONFIG_ACTIONS=./config_actions.json
TEMPLATES_DIR=./templates


MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=xxxx
MONGODB_USER=xxxxx
MONGODB_PASS=xxxxx
MONGODB_AUTH_DB=admin

UPLOAD_DIR=./uploads

LOGIN_REDIRECT=/index

# MQTT (optionnel — décommenter pour activer)
MQTT_BROKER_URL=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=small-folks-mqtt
MQTT_TOPICS=sensors/#
MQTT_QOS=1