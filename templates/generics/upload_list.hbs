{{> partials/header page_title="Fichiers uploadés"}}
{{> partials/nav}}

<div class="container">
  <div class="card">
    <h1>Fichiers uploadés</h1>
    <p style="margin-bottom:1rem;">
      <a href="/upload/form"
         style="padding:.5rem 1rem; background:#2c3e50; color:#fff;
                border-radius:4px; text-decoration:none;">
        + Nouveau fichier
      </a>
    </p>

    {{#if data}}
    <table id="data" class="datatable display" style="width:100%">
      <thead>
        <tr>
          {{#each data}}{{#if @first}}
            {{#each this}}<th>{{@key}}</th>{{/each}}
          {{/if}}{{/each}}
        </tr>
      </thead>
      <tbody>
        {{#each data}}
        <tr>
          {{#each this}}<td>{{this}}</td>{{/each}}
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
    <p style="color:#888; font-style:italic;">Aucun fichier uploadé pour l'instant.</p>
    {{/if}}

  </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const tables = document.querySelectorAll('table');
  tables.forEach(function(t) {

    {{#if row_link}}
    {{!-- Avec lien sur la colonne row_link_col --}}
    new DataTable(t, {
      pageLength: 25,
      language: {
        search:     "Rechercher :",
        lengthMenu: "Afficher _MENU_ lignes",
        info:       "Lignes _START_ à _END_ sur _TOTAL_",
        paginate:   { previous: "Préc.", next: "Suiv." }
      },
      columnDefs: [
        {
          targets: {{row_link_col}},
          render: function(data, type, row, meta) {
            if (type === 'display') {
              return '<a href="{{row_link}}/' + data + '">' + data + '</a>';
            }
            return data;
          }
        }
      ]
    });
    {{else}}
    {{!-- Sans lien --}}
    new DataTable(t, {
      pageLength: 25,
      language: {
        search:     "Rechercher :",
        lengthMenu: "Afficher _MENU_ lignes",
        info:       "Lignes _START_ à _END_ sur _TOTAL_",
        paginate:   { previous: "Préc.", next: "Suiv." }
      }
    });
    {{/if}}

  });
});
</script>
{{> partials/footer}}