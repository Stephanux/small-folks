{{> partials/header page_title="Résultats"}}
{{> partials/nav}}

<div class="container">
  <div class="card">
    {{#if page_title}}
    <h1>{{page_title}}</h1>
    {{/if}}

    {{#if this}}
    <table id="data" class="datatable display" style="width:100%">
      <thead>
        <tr>
          {{#each this.0}}
          <th>{{@key}}</th>
          {{/each}}
        </tr>
      </thead>
      <tbody>
        {{#each this}}
        <tr>
          {{#each this}}
          <td>{{this}}</td>
          {{/each}}
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
    <p style="color:#888; font-style:italic;">Aucun résultat.</p>
    {{/if}}
  </div>
</div>

{{> partials/footer}}
