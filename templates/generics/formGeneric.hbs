{{> partials/header page_title="Formulaire"}}
{{> partials/nav}}

<div class="container">
  <form class="generic-form" method="POST" id="formgeneric" action="{{form_action}}">

    {{#each data.0}}
    <div class="form-group">
      <label class="form-label" for="{{@key}}">{{@key}}</label>

      {{#if (lookup @root.resources @key)}}
        {{!-- Ce champ a une ressource → liste déroulante --}}
        <select class="form-input form-select" id="{{@key}}" name="{{@key}}">
          <option value="">-- choisir --</option>
          {{#each (lookup @root.resources @key)}}
            <option value="{{this.[0]}}">{{this.[1]}}</option>
          {{/each}}
        </select>
      {{else}}
        {{!-- Champ texte standard --}}
        <input class="form-input" type="text"
               id="{{@key}}" name="{{@key}}" value="{{this}}">
      {{/if}}

    </div>
    {{/each}}

    <div class="form-actions">
      <button type="submit" class="btn-submit">Enregistrer</button>
      <a href="javascript:history.back()" class="btn-cancel">Annuler</a>
    </div>

  </form>
</div>

{{> partials/footer}}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const form_action = (document.getElementById("formgeneric").action.split('8080/')[1]).split('_')[0];
        console.log("type action : ", form_action);
        {{!-- 
            // Utilisation du paramètre config_actions.json "form_action" pour détecter le type de formulaire (insertion ou modification) 
            et dans le cas de l'insertion on efface les données du formulaire via la boucle ci-dessousz
        --}}
        if (form_action === "insert") {
            const list_fields = document.getElementsByClassName("form-input");
            for (const el of list_fields) {
              el.value = "";
            }
        }
        
    });
</script>