{{> partials/header page_title="Formulaire"}}
{{> partials/nav}}

<div class="container">
  <form id="formgeneric" class="generic-form {{#if (eq form_columns 2)}}form-2col{{/if}}"
        method="POST" action="{{form_action}}">

    {{!--
      Chaque champ de data.0.fields arrive sous la forme :
        { key, value, fullwidth, label?, type?, readonly? }
      label / type / readonly proviennent de "fields_meta" (config_actions.json).
      Sans fields_meta : label = key, type = "text".
    --}}
    {{#each data.0.fields}}
    <div class="form-group {{#if fullwidth}}form-group-full{{/if}}">
      <label class="form-label" for="{{key}}">{{#if label}}{{label}}{{else}}{{key}}{{/if}}</label>

      {{#if (lookup @root.resources key)}}
        {{!--
          Liste déroulante : options { val, label, selected } (selected pré-calculé côté Rust).
          Source : data_resources/sql_resources (SQL) ou fields_meta.options (statique).
        --}}
        <select class="form-input form-select" id="{{key}}" name="{{key}}" {{#if readonly}}disabled{{/if}}>
          <option value="">-- choisir --</option>
          {{#each (lookup @root.resources key)}}
            <option value="{{val}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>

      {{else if (eq type "textarea")}}
        <textarea class="form-input" id="{{key}}" name="{{key}}" rows="4"
                  {{#if readonly}}readonly{{/if}}>{{value}}</textarea>

      {{else if (eq type "file")}}
        {{!-- nécessite enctype="multipart/form-data" + plugin_sql_upload --}}
        <input class="form-input" type="file" id="{{key}}" name="{{key}}">

      {{else if (eq key "image")}}
        {{!-- compatibilité : ancien cas particulier de la colonne "image" --}}
        <input type="file" id="image" name="image" accept=".jpg,.jpeg,.png,.pdf"
               style="width:100%; padding:.5rem; border:1px solid #ccc; border-radius:4px;">

      {{else}}
        <input class="form-input" type="{{#if type}}{{type}}{{else}}text{{/if}}"
               id="{{key}}" name="{{key}}" value="{{value}}" {{#if readonly}}readonly{{/if}}>
      {{/if}}

    </div>
    {{/each}}

    <div class="form-actions form-group-full">
      <button type="submit" class="btn-submit">Enregistrer</button>
      <a href="javascript:history.back()" class="btn-cancel">Annuler</a>
    </div>

  </form>
</div>
{{> partials/footer}}
<script>
document.addEventListener('DOMContentLoaded', function () {
  {{!--
    Mode insert/update détecté depuis form_action ("/insert_XXX" ou "/update_XXX").
    pathname évite de dépendre du port (l'ancienne version coupait sur "8080/").
    En mode insert, on vide les champs texte (les selects restent sur "-- choisir --").
  --}}
  const form = document.getElementById("formgeneric");

  {{!--
    Champ fichier présent → le formulaire doit être envoyé en multipart/form-data
    (sinon plugin_sql_upload reçoit du x-www-form-urlencoded : "sans boundary").
    Sans champ fichier on garde l'encodage par défaut, que plugin_sql sait lire.
  --}}
  if (form.querySelector('input[type="file"]')) {
    form.setAttribute("enctype", "multipart/form-data");
  }

  const path = new URL(form.action).pathname;
  const mode = path.split('/').pop().split('_')[0];
  console.log("[formGeneric] mode :", mode);

  if (mode === "insert") {
    for (const el of document.getElementsByClassName("form-input")) {
      if (el.tagName !== "SELECT" && el.type !== "file") { el.value = ""; }
    }
  }
});
</script>
