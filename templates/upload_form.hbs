{{> partials/header page_title="Upload de fichiers"}}
{{> partials/nav}}

<div class="container">
  <div class="card">
    <h1>Déposer un fichier</h1>
    <form action="/upload" method="POST" enctype="multipart/form-data"
          style="display:flex; flex-direction:column; gap:1rem; max-width:480px; margin-top:1.5rem;">
      <div>
        <label for="file" style="display:block; margin-bottom:.4rem; font-weight:500;">
          Fichier (jpg, png, pdf — max 10 Mo)
        </label>
        <input type="file" id="file" name="file"
               accept=".jpg,.jpeg,.png,.pdf"
               style="width:100%; padding:.5rem; border:1px solid #ccc; border-radius:4px;">
      </div>
      <button type="submit"
              style="padding:.6rem 1.4rem; background:#2c3e50; color:#fff;
                     border:none; border-radius:4px; cursor:pointer; font-size:1rem;">
        Envoyer
      </button>
    </form>
  </div>
</div>

{{> partials/footer}}
