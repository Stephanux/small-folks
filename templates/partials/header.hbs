<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{#if page_title}}{{page_title}}{{else}}Rust Plugin Tide{{/if}}</title>
  <link rel="stylesheet" href="https://cdn.datatables.net/2.3.7/css/dataTables.dataTables.css"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, sans-serif; background: #f5f5f5; color: #333; }
    .container { max-width: 1200px; margin: 0 auto; padding: 1.5rem; }
    h1 { font-size: 1.4rem; font-weight: 600; margin-bottom: 1.2rem; color: #222; }
    .card { background: #fff; border-radius: 8px; padding: 1.5rem;
            box-shadow: 0 1px 4px rgba(0,0,0,.08); }
    table.dataTable thead th { background: #f0f0f0; }
    .alert-error { background: #fdecea; border-left: 4px solid #e53935;
                   padding: .8rem 1rem; border-radius: 4px; color: #c62828; }
    .alert-success { background: #e8f5e9; border-left: 4px solid #43a047;
                     padding: .8rem 1rem; border-radius: 4px; color: #2e7d32; }
  </style>
  <script src="https://code.jquery.com/jquery-3.5.1.js"></script>
  <script src="https://cdn.datatables.net/2.3.7/js/dataTables.js"></script>
